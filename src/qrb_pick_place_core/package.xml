<?xml version="1.0"?>
<package format="3">
  <name>qrb_pick_place_core</name>
  <version>0.1.0</version>
  <description>Qualcomm's RML-63 pick-and-place sample, ported from MoveIt 2 to MoveIt Pro Core.</description>
  <maintainer email="support@picknik.ai">MoveIt Pro Maintainer</maintainer>
  <license>BSD-3-Clause-Clear</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- MoveIt Pro packages; no moveit_core / moveit_ros_* / move_group. -->
  <depend>moveit_pro_base</depend>
  <depend>moveit_pro_planning_scene_monitor</depend>
  <depend>pro_rrt</depend>

  <depend>control_msgs</depend>
  <depend>moveit_pro_controllers_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
