<?xml version="1.0" encoding="UTF-8" ?>
<!-- The RML-63 gripper is four position-controlled joints on a JointTrajectoryController, so it moves like an arm
     group rather than through a GripperCommand action. -->
<root BTCPP_format="4" main_tree_to_execute="QRB Move Gripper">
  <BehaviorTree
    ID="QRB Move Gripper"
    _description="Move the RML-63 gripper to a saved waypoint on hand_controller."
  >
    <SubTree
      ID="Move to Named Waypoint (JTC)"
      _collapsed="true"
      waypoint_name="{waypoint_name}"
      joint_group_name="hand_controller"
      controller_names="hand_controller"
      controller_action_server="/hand_controller/follow_joint_trajectory"
      velocity_scale_factor="0.3"
      acceleration_scale_factor="0.3"
    />
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="QRB Move Gripper">
      <MetadataFields>
        <Metadata subcategory="QRB Samples" />
        <Metadata runnable="false" />
      </MetadataFields>
      <input_port name="waypoint_name" default="open" type="std::string" />
    </SubTree>
  </TreeNodesModel>
</root>
