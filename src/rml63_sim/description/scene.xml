<!-- Qualcomm QRB warehouse pick cell for the MoveIt Pro Simulator.
     Recreates qrb_ros_sim_gazebo/worlds/warehouse.sdf with the RML-63 at Qualcomm's spawn pose. -->
<mujoco model="qrb_pick_cell">
  <compiler angle="radian" autolimits="true" meshdir="assets" texturedir="assets" />
  <option integrator="implicitfast" timestep="0.002" cone="elliptic" impratio="10" />

  <default>
    <default class="warehouse">
      <geom rgba="0.55 0.55 0.5 1" />
    </default>
    <default class="table">
      <geom material="table_wood" />
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.25 0.25" rgb2="0.3 0.3 0.3" width="512" height="512" />
    <material name="groundplane" texture="grid" texrepeat="40 40" reflectance="0.05" />
    <texture name="table_wood" type="2d" file="table_diffuse.png" />
    <material name="table_wood" texture="table_wood" />
    <texture name="coke" type="2d" file="coke.png" />
    <material name="coke" texture="coke" />
    <mesh name="coke" file="coke.obj" />
    <texture name="cardboard" type="2d" file="cardboard_box.png" />
    <material name="cardboard" texture="cardboard" />
  </asset>

  <include file="rml63.xml" />
  <include file="warehouse.xml" />

  <worldbody>
    <light pos="2.5 -2 4" dir="0 0 -1" directional="true" />
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" />

    <!-- Fuel OpenRobotics/Table (CC0): 1.5 x 0.8 top at z=1.0, four legs. Gazebo pose yaw=pi/2. -->
    <body name="table1" pos="2 -2 0" euler="0 0 1.5708">
      <geom class="table" type="box" pos="0 0 1.0" size="0.75 0.4 0.015" />
      <geom class="table" type="cylinder" pos="0.68 0.38 0.5" size="0.02 0.5" />
      <geom class="table" type="cylinder" pos="0.68 -0.38 0.5" size="0.02 0.5" />
      <geom class="table" type="cylinder" pos="-0.68 0.38 0.5" size="0.02 0.5" />
      <geom class="table" type="cylinder" pos="-0.68 -0.38 0.5" size="0.02 0.5" />
    </body>
    <body name="table2" pos="2.794 -2 0" euler="0 0 1.5708">
      <geom class="table" type="box" pos="0 0 1.0" size="0.75 0.4 0.015" />
      <geom class="table" type="cylinder" pos="0.68 0.38 0.5" size="0.02 0.5" />
      <geom class="table" type="cylinder" pos="0.68 -0.38 0.5" size="0.02 0.5" />
      <geom class="table" type="cylinder" pos="-0.68 0.38 0.5" size="0.02 0.5" />
      <geom class="table" type="cylinder" pos="-0.68 -0.38 0.5" size="0.02 0.5" />
    </body>

    <!-- Fuel OpenRobotics/Coke (CC-BY-4.0): 0.06 dia x 0.145 tall, origin at base.
         Collision is a cylinder; the mesh is visual only. Mass from a full 330 ml can. -->
    <body name="coke1" pos="3 -2 1.025">
      <freejoint name="coke1" />
      <geom type="mesh" mesh="coke" material="coke" contype="0" conaffinity="0" group="1" />
      <geom name="coke1_collision" type="cylinder" pos="0 0 0.0724" size="0.0299 0.0724" mass="0.35" friction="1.5 0.02 0.002" rgba="0.8 0 0 0" />
    </body>
    <body name="coke2" pos="3 -1.5 1.025">
      <freejoint name="coke2" />
      <geom type="mesh" mesh="coke" material="coke" contype="0" conaffinity="0" group="1" />
      <geom name="coke2_collision" type="cylinder" pos="0 0 0.0724" size="0.0299 0.0724" mass="0.35" friction="1.5 0.02 0.002" rgba="0.8 0 0 0" />
    </body>

    <!-- Fuel QCforward/carboard box (CC-BY-4.0): 0.5 x 0.4 x 0.3, 2 kg. -->
    <body name="cardboard_box" pos="2.95 -2.5 1.17">
      <freejoint name="cardboard_box" />
      <geom type="box" size="0.25 0.2 0.15" mass="2" material="cardboard" />
    </body>
  </worldbody>
  <!-- default: Qualcomm qrb_ros_sim_gazebo/config/params/initial_positions.yaml -->
  <keyframe>
    <key name="default"
      qpos="0 1.29673 -1.80447 -0.0600454 -1.09239 0.015705 0.1 -0.1 -0.1 0.1 3 -2 1.025 1 0 0 0 3 -1.5 1.025 1 0 0 0 2.95 -2.5 1.17 1 0 0 0"
      ctrl="0 1.29673 -1.80447 -0.0600454 -1.09239 0.015705 0.1 -0.1 -0.1 0.1" />
  </keyframe>
</mujoco>
