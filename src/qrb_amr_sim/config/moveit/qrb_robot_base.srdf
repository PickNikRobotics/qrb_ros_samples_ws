<?xml version="1.0" encoding="UTF-8"?>
<robot name="qrb_robot_base">
    <!-- World objects stay in odom while the state monitor tracks the base through the diff-drive controller's
         odom -> base_footprint TF. -->
    <virtual_joint name="base_planar_joint" type="planar" parent_frame="odom" child_link="base_footprint"/>
    <group name="base">
        <joint name="wheel_left_joint"/>
        <joint name="wheel_right_joint"/>
    </group>
    <disable_collisions link1="base_link" link2="wheel_left" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="wheel_right" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="caster_wheel_link1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="caster_wheel_link2" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="caster_wheel_link3" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="caster_wheel_link4" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="laser" reason="Adjacent"/>
</robot>
